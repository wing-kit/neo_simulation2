    </link>

    <!-- Second Backward ultrasonic sensor link -->
    <link name="ultrasonic_backward_2_link">
        <visual>
            <geometry>
                <cylinder radius="0.02" length="0.03"/>
            </geometry>
            <material name="red"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.02" length="0.03"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.01"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
        </inertial>
    </link>

    <!-- Forward ultrasonic sensor Gazebo configuration -->
    <gazebo reference="ultrasonic_forward_link">
        <material>Gazebo/Blue</material>
        
        <sensor name="ultrasonic_forward_sensor" type="ray">
            <always_on>1</always_on>
            <visualize>true</visualize>
            <update_rate>10</update_rate>
            <ray>
                <scan>
                    <horizontal>
                        <samples>2</samples>
                        <resolution>1</resolution>
                        <min_angle>-0.01</min_angle>
                        <max_angle>0.01</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.12</min>
                    <max>20.0</max>
                    <resolution>0.001</resolution>
                </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.001</stddev>
                </noise>
            </ray>
            <plugin filename="libgazebo_ros_ray_sensor.so" name="ultrasonic_forward_plugin">
                <ros>
                    <argument>~/out:=laser_front_1</argument>
                </ros>
                <output_type>sensor_msgs/LaserScan</output_type>
                <frame_name>ultrasonic_forward_link</frame_name>
            </plugin>
        </sensor>
    </gazebo>

