<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Forward ultrasonic sensor joint 1 -->
    <joint name="ultrasonic_forward_joint" type="fixed">
        <parent link="base_link"/>
        <child link="ultrasonic_forward_link"/>
        <origin xyz="0.25 0.25 0.5" rpy="0 0 0"/>
    </joint>

    <!-- Forward ultrasonic sensor joint 2 -->
    <joint name="ultrasonic_forward_2_joint" type="fixed">
        <parent link="base_link"/>
        <child link="ultrasonic_forward_2_link"/>
        <origin xyz="0.25 -0.25 0.5" rpy="0 0 0"/>
    </joint>

    <!-- Left ultrasonic sensor joint 1 -->
    <joint name="ultrasonic_left_joint" type="fixed">
        <parent link="base_link"/>
        <child link="ultrasonic_left_link"/>
        <origin xyz="0.25 0.25 0.5" rpy="0 0 1.5708"/>
    </joint>

    <!-- Left ultrasonic sensor joint 2 -->
    <joint name="ultrasonic_left_2_joint" type="fixed">
        <parent link="base_link"/>
        <child link="ultrasonic_left_2_link"/>
        <origin xyz="-0.25 0.25 0.5" rpy="0 0 1.5708"/>
    </joint>

    <!-- Right ultrasonic sensor joint 1 -->
    <joint name="ultrasonic_right_joint" type="fixed">
        <parent link="base_link"/>
        <child link="ultrasonic_right_link"/>
        <origin xyz="0.25 -0.25 0.5" rpy="0 0 -1.5708"/>
    </joint>

    <!-- Right ultrasonic sensor joint 2 -->
    <joint name="ultrasonic_right_2_joint" type="fixed">
        <parent link="base_link"/>
        <child link="ultrasonic_right_2_link"/>
        <origin xyz="-0.25 -0.25 0.5" rpy="0 0 -1.5708"/>
    </joint>

    <!-- Backward ultrasonic sensor joint 1 -->
    <joint name="ultrasonic_backward_joint" type="fixed">
        <parent link="base_link"/>
        <child link="ultrasonic_backward_link"/>
        <origin xyz="-0.25 -0.25 0.5" rpy="0 0 3.14159"/>
    </joint>

    <!-- Backward ultrasonic sensor joint 2 -->
    <joint name="ultrasonic_backward_2_joint" type="fixed">
        <parent link="base_link"/>
        <child link="ultrasonic_backward_2_link"/>
        <origin xyz="-0.25 0.25 0.5" rpy="0 0 3.14159"/>
    </joint>

    <!-- Forward ultrasonic sensor link -->
    <link name="ultrasonic_forward_link">
        <visual>
            <geometry>
                <cylinder radius="0.02" length="0.03"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.02" length="0.03"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.01"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
        </inertial>
    </link>

    <!-- Left ultrasonic sensor link -->
    <link name="ultrasonic_left_link">
        <visual>
            <geometry>
                <cylinder radius="0.02" length="0.03"/>
            </geometry>
            <material name="green"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.02" length="0.03"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.01"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
        </inertial>
    </link>

    <!-- Right ultrasonic sensor link -->
    <link name="ultrasonic_right_link">
        <visual>
            <geometry>
                <cylinder radius="0.02" length="0.03"/>
            </geometry>
            <material name="yellow"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.02" length="0.03"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.01"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
        </inertial>
    </link>

    <!-- Backward ultrasonic sensor link -->
    <link name="ultrasonic_backward_link">
        <visual>
            <geometry>
                <cylinder radius="0.02" length="0.03"/>
            </geometry>
            <material name="red"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.02" length="0.03"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.01"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
        </inertial>
    </link>

    <!-- Second Forward ultrasonic sensor link -->
    <link name="ultrasonic_forward_2_link">
        <visual>
            <geometry>
                <cylinder radius="0.02" length="0.03"/>
